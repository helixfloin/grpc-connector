<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Deliberately NOT a module of the microintegrator-parent reactor and not
    sharing its groupId - see examples/order-validator-connector/pom.xml for
    the same convention. Like examples/s3-upload-connector, this connector's
    runtime dependencies (grpc-stub/grpc-protobuf/grpc-netty-shaded and their
    own transitive protobuf-java) are NOT already on the host runtime's
    classpath, so the shade plugin below bundles them into one self-contained
    jar - drop the result straight into deployment/connectors/ (or any
    project's own connectors/ - see hf-mgmt's ConnectorClassLoader, which
    loads every *.jar it finds there directly) with no lib.yaml required at
    all, unlike deployment/projects/grpc-example (the other gRPC example in
    this repo, which resolves the same libraries via lib.yaml + a separately
    precompiled stub jar in lib-ext/ instead). Same RPC, two different ways
    of shipping a connector with third-party runtime dependencies.

    src/main/java/helixflo/example/grpc/*.java is the protoc-generated
    Greeter stub, checked in as plain source rather than regenerated by a
    build-time protoc plugin - kept readable/diffable like every other file
    here, and it sidesteps the exact protoc/protobuf-java version-mismatch
    trap documented in deployment/projects/grpc-example/README.md (protoc
    25.9, matching the protobuf-java 3.25.9 that grpc-protobuf:1.83.1 pulls
    transitively). Regenerate it the same way that README describes if you
    change greeter.proto (kept here under src/main/proto/ for reference).
  -->
  <groupId>com.acme</groupId>
  <artifactId>grpc-connector</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <grpc.version>1.83.1</grpc.version>
  </properties>

  <dependencies>
    <!-- Resolved from the local repo where hf-core was installed (mvn install). -->
    <dependency>
      <groupId>io.helixflo</groupId>
      <artifactId>hf-core</artifactId>
      <version>1.0.0</version>
      <!-- provided: hf-core is already on the host runtime's classpath, no need to bundle it -->
      <scope>provided</scope>
    </dependency>

    <!-- Bundled into the shaded jar below - not on the host runtime's classpath. -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <!-- The actual transport ManagedChannelBuilder.forAddress(...) needs at runtime -
         grpc-stub/grpc-protobuf alone only give you the generated client API surface.
         Already shaded upstream (bundles its own Netty), so nothing further to exclude here. -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
      <version>${grpc.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <!-- provided-scope hf-core is excluded from the shaded jar automatically -
                   shade only bundles compile-scope dependencies. -->
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
